<nodeDefs>

  <!-- WhatsApp Node -->
  <nodeDef id="{0}" nls="wa">
    <editors />
    <sts>
      <st id="ST"  editor="bool" />
      <st id="ERR" editor="PO_ERR" />
      <st id="GV1" editor="WA_P_{1}" />
      <st id="GV3" editor="MESSAGE" />
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="SET_PHONE">
          <p id="" editor="WA_P_{1}" init="GV1"/>
        </cmd>
        <cmd id="SET_MESSAGE">
          <p id="" editor="MESSAGE" init="GV3"/>
        </cmd>
        <cmd id="SET_SYS_CUSTOM">
          <p id="" editor="{2}"/>
        </cmd>
        <cmd id="GV10">
          <p id="Phone" editor="WA_P_{1}" init="GV1" optional="T"/>
          <p id="Content" editor="{2}"/>
        </cmd>
        <cmd id="SEND_MY_MESSAGE" />
        <cmd id="SEND_MY_SYS_CUSTOM" />
      </accepts>
    </cmds>
  </nodeDef>

  <!--- WhatsApp Notify Node -->
  <nodeDef id="{0}_notify" nls="wanfy">
      <editors />
      <sts>
          <st id="ST"  editor="bool" />
          <st id="GV1" editor="NMESSAGE" />
          <st id="GV2" editor="NMESSAGE" />

      </sts>
      <cmds>
          <sends />
          <accepts>
            <cmd id="SET_MESSAGE_DON">
              <p id="" editor="NMESSAGE" init="GV1"/>
            </cmd>
            <cmd id="SET_MESSAGE_DOF">
              <p id="" editor="NMESSAGE" init="GV2"/>
            </cmd>
            <cmd id="DON" />
            <cmd id="DOF" />
          </accepts>
      </cmds>
  </nodeDef>

</nodeDefs>
